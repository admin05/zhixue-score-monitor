{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhixue-score-monitor",
  "main": "src/index.js",
  "compatibility_date": "2026-11-12",
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
